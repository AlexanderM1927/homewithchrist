NODE_ENV=development

PORT=8004

# ollama: local only, openai: OpenAI only, hybrid: Ollama first and OpenAI fallback.
AI_PROVIDER=ollama
OLLAMA_URL=
MAIN_OLLAMA_MODEL=gemma3:4b
SECONDARY_OLLAMA_MODEL=qwen3:0.6b
EMBEDDING_OLLAMA_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_MS=5000
OLLAMA_CHAT_TIMEOUT_MS=300000
OLLAMA_KEEP_ALIVE=10m
HYBRID_PRIMARY_COOLDOWN_MS=60000
BIBLE_CONTEXT_VERSION=CEE

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MAIN_MODEL=gpt-5.4-mini
OPENAI_SECONDARY_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_OUTPUT_TOKENS=700
OPENAI_MONTHLY_BUDGET_USD=20
OPENAI_USER_MONTHLY_BUDGET_USD=2
# Override these only if you change to a model not known by the app.
OPENAI_INPUT_PRICE_PER_1M_TOKENS=
OPENAI_OUTPUT_PRICE_PER_1M_TOKENS=

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

ALLOWED_ORIGINS=
