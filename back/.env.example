NODE_ENV=development

PORT=8004

# ollama: local only, openai: OpenAI only, hybrid: Ollama first and OpenAI fallback.
AI_PROVIDER=ollama
OLLAMA_URL=
MAIN_OLLAMA_MODEL=gemma3:4b
SECONDARY_OLLAMA_MODEL=qwen3:0.6b
EMBEDDING_OLLAMA_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_MS=5000
OLLAMA_CHAT_TIMEOUT_MS=300000
OLLAMA_KEEP_ALIVE=10m
HYBRID_PRIMARY_COOLDOWN_MS=60000
BIBLE_CONTEXT_VERSION=CEE

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MAIN_MODEL=gpt-5.4-mini
OPENAI_SECONDARY_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_OUTPUT_TOKENS=700
OPENAI_MONTHLY_BUDGET_USD=20
OPENAI_USER_MONTHLY_BUDGET_USD=2
# Override these only if you change to a model not known by the app.
OPENAI_INPUT_PRICE_PER_1M_TOKENS=
OPENAI_OUTPUT_PRICE_PER_1M_TOKENS=

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_RESET_SECRET=

ALLOWED_ORIGINS=
FRONTEND_URL=http://localhost:9000

# SendGrid SMTP email delivery
SENDGRID_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Home With Christ
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=

# Firebase Cloud Messaging (contenido JSON de una cuenta de servicio en base64)
FIREBASE_SERVICE_ACCOUNT_BASE64=base64_del_service_account_json

# Notificacion diaria del versiculo
DAILY_VERSE_NOTIFICATION_TIME_ZONE=America/Bogota
DAILY_VERSE_NOTIFICATION_HOUR=12
DAILY_VERSE_NOTIFICATION_MINUTE=0
DAILY_VERSE_NOTIFICATION_MAX_ATTEMPTS=5
DAILY_VERSE_NOTIFICATION_RETRY_BASE_MINUTES=5
