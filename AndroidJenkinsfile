pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    environment {
        ANDROID_HOME = "/opt/android-sdk"
        ANDROID_SDK_ROOT = "/opt/android-sdk"
        PATH = "/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:${env.PATH}"
    }

    stages {
        stage('Build Android') {
            tools {
                nodejs 'node-22.22.3'
            }

            steps {
                withCredentials([file(credentialsId: 'envhwc-front', variable: 'ENV_FILE')]) {
                    sh 'rm -f ./front/.env'
                    sh 'cp "$ENV_FILE" ./front/.env'
                }
                dir('./front') {
                    sh '''
                    set -e

                    echo "[android] Installing dependencies..."
                    npm ci

                    echo "[android] Installing Capacitor dependencies..."
                    cd ./src-capacitor
                    npm ci
                    cd ..

                    echo "[android] Generating icons..."
                    npx icongenie generate -m capacitor -i ./public/logo.png

                    echo "[android] Building SPA..."
                    quasar build -m capacitor -T android

                    echo "[frontend] Updating Capacitor version..."

                    echo "{\"version\":\"${BUILD_NUMBER}-$(date +%s)\"}" > ./src-capacitor/www/version.json

                    cat ./src-capacitor/www/version.json
                    '''
                }
            }
        }

        stage('Generate Keystore Properties') {
            steps {
                dir('./front/src-capacitor/android') {
                    withCredentials([
                        string(credentialsId: 'ANDROID_STORE_PASSWORD', variable: 'STORE_PASSWORD'),
                        string(credentialsId: 'ANDROID_KEY_PASSWORD', variable: 'KEY_PASSWORD')
                    ]) {
                        sh '''
                        cat > keystore.properties <<EOF
storeFile=/opt/android-keystore/hwc-upload-key.jks
storePassword=$STORE_PASSWORD
keyAlias=hwc
keyPassword=$KEY_PASSWORD
EOF
                        '''
                    }
                }
            }
        }

        stage('Capacitor Sync') {
            tools {
                nodejs 'node-22.22.3'
            }

            steps {
                dir('./front/src-capacitor') {
                    sh '''
                    set -e

                    rm -rf android/.gradle
                    rm -rf android/build
                    rm -rf android/capacitor-cordova-android-plugins/build
                    rm -rf android/app/src/main/assets/public

                    npm ci

                    npx cap sync android

                    echo "===== CAPACITOR VERSION FILE ====="
                    cat android/app/src/main/assets/public/version.json || true
                    '''
                }
            }
        }

        stage('Generate AAB') {
            steps {
                dir('./front/src-capacitor/android') {
                    sh '''
                    chmod +x gradlew

                    echo "===== Updating Android Version ====="

                    sed -i "s/versionCode .*/versionCode ${BUILD_NUMBER}/" app/build.gradle
                    sed -i 's/versionName ".*"/versionName "1.0.'${BUILD_NUMBER}'"/' app/build.gradle

                    grep -E "versionCode|versionName" app/build.gradle

                    echo "[android] Generating signed AAB..."
                    ./gradlew bundleRelease
                    echo "[android] Generating apk to test..."
                    ./gradlew assembleRelease

                    echo "[android] Verifying generated artifacts..."
                    ls -lah app/build/outputs/apk/release || true
                    ls -lah app/build/outputs/bundle/release || true

                    if [ ! -f app/build/outputs/apk/release/app-release.apk ]; then
                      echo "Signed release APK not found"
                      exit 1
                    fi

                    echo "[android] Checking APK integrity..."
                    unzip -t app/build/outputs/apk/release/app-release.apk >/tmp/hwc-apk-unzip-check.txt
                    cat /tmp/hwc-apk-unzip-check.txt

                    echo "[android] Checking APK signature..."
                    "$ANDROID_HOME/build-tools/36.0.0/apksigner" verify --verbose --print-certs app/build/outputs/apk/release/app-release.apk > /tmp/hwc-apk-signature.txt
                    cat /tmp/hwc-apk-signature.txt
                    '''
                }
            }
        }
    }

    post {
        success {
            archiveArtifacts(
                artifacts: 'front/src-capacitor/android/app/build/outputs/bundle/release/*.aab, front/src-capacitor/android/app/build/outputs/apk/release/*.apk',
                fingerprint: true
            )
        }
    }
}
